@using System
@model AplicaciónWebTest1.Models.ProductoIndexViewModel
@{
    ViewData["Title"] = "Productos";
    bool Toggle(string campo) => Model.OrdenActual.Equals(campo, StringComparison.OrdinalIgnoreCase) ? !Model.OrdenDesc : false;
    var sizes = new[] { 5, 10, 20, 50 };
    var prevDisabled = Model.Resultado.PageIndex <= 1 ? "disabled" : string.Empty;
    var nextDisabled = Model.Resultado.PageIndex >= Model.Resultado.TotalPages ? "disabled" : string.Empty;
    var descId = Toggle("ID");
    var descNombre = Toggle("Nombre");
    var descPrecio = Toggle("Precio");
}

<h1 class="mb-3">Listado de Productos</h1>

<form asp-action="Index" method="get" class="row g-2 mb-3">
    <div class="col-sm-4">
        <input type="text" name="busqueda" value="@Model.Busqueda" class="form-control" placeholder="Buscar por nombre" />
    </div>
    <div class="col-sm-3">
        <select name="pageSize" class="form-select">
            @foreach (var size in sizes)
            {
                if (size == Model.Resultado.PageSize)
                {
                    <option value="@size" selected>@size registros</option>
                }
                else
                {
                    <option value="@size">@size registros</option>
                }
            }
        </select>
    </div>
    <div class="col-sm-3">
        <button type="submit" class="btn btn-primary">Filtrar</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Limpiar</a>
    </div>
</form>

<p>
    <a class="btn btn-success" asp-action="Create">Crear Nuevo</a>
</p>

<table class="table table-striped table-bordered">
    <thead class="table-light">
        <tr>
            <th>
                <a asp-action="Index" asp-route-ordenarPor="ID" asp-route-desc="@descId" asp-route-busqueda="@Model.Busqueda" asp-route-pageSize="@Model.Resultado.PageSize">Id</a>
            </th>
            <th>
                <a asp-action="Index" asp-route-ordenarPor="Nombre" asp-route-desc="@descNombre" asp-route-busqueda="@Model.Busqueda" asp-route-pageSize="@Model.Resultado.PageSize">Nombre</a>
            </th>
            <th class="text-end">
                <a asp-action="Index" asp-route-ordenarPor="Precio" asp-route-desc="@descPrecio" asp-route-busqueda="@Model.Busqueda" asp-route-pageSize="@Model.Resultado.PageSize">Precio</a>
            </th>
            <th class="text-center">Acciones</th>
        </tr>
    </thead>
    <tbody>
    @foreach (var item in Model.Resultado.Items)
    {
        <tr>
            <td>@item.Id</td>
            <td>@item.Nombre</td>
            <td class="text-end">@item.Precio.ToString("C")</td>
            <td class="text-center">
                <a class="btn btn-sm btn-primary" asp-action="Edit" asp-route-id="@item.Id">Editar</a>
                <a class="btn btn-sm btn-danger" asp-action="Delete" asp-route-id="@item.Id">Eliminar</a>
            </td>
        </tr>
    }
    </tbody>
</table>

<nav aria-label="Paginación">
    <ul class="pagination">
        <li class="page-item @prevDisabled">
            <a class="page-link" asp-action="Index" asp-route-page="@(Model.Resultado.PageIndex - 1)" asp-route-pageSize="@Model.Resultado.PageSize" asp-route-busqueda="@Model.Busqueda" asp-route-ordenarPor="@Model.OrdenActual" asp-route-desc="@Model.OrdenDesc">Anterior</a>
        </li>
        <li class="page-item disabled"><span class="page-link">Página @Model.Resultado.PageIndex de @Model.Resultado.TotalPages</span></li>
        <li class="page-item @nextDisabled">
            <a class="page-link" asp-action="Index" asp-route-page="@(Model.Resultado.PageIndex + 1)" asp-route-pageSize="@Model.Resultado.PageSize" asp-route-busqueda="@Model.Busqueda" asp-route-ordenarPor="@Model.OrdenActual" asp-route-desc="@Model.OrdenDesc">Siguiente</a>
        </li>
    </ul>
</nav>
